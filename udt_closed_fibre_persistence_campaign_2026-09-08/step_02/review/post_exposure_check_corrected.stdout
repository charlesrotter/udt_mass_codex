    {
      "mode": "baseline",
      "returncode": 0,
      "stdout": "{\n  \"kind\": \"exact finite symbolic controls NOT global existence or closure proof\",\n  \"mode\": \"baseline\",\n  \"sympy_version\": \"1.13.1\",\n  \"checks\": {\n    \"coframe_dual_e2\": true,\n    \"coframe_dual_xi\": true,\n    \"polarization_tracefree\": true,\n    \"polarization_radial_transverse\": true,\n    \"metric_reflection_invariant\": true,\n    \"polarization_reflection_invariant\": true,\n    \"torus_invariance_alone_does_not_remove_cross_term\": true,\n    \"reflection_rejects_radial_cross_term\": true,\n    \"actual_symbol_projection_fixes_E\": true,\n    \"full_radial_slope_symbol\": true,\n    \"center_symbol\": true,\n    \"real_odd_phase_third_derivative\": true,\n    \"center_N3_coefficient\": true,\n    \"both_gap_signs_retained\": true,\n    \"coordinate_initial_ricci_vertical\": true,\n    \"coordinate_initial_ricci_horizontal\": true,\n    \"full_inverse_raising_contribution\": true,\n    \"coordinate_full_third_jet_anchor\": true,\n    \"coordinate_no_radial_image\": true,\n    \"coordinate_full_variation_symmetric\": true,\n    \"constraint_trace_is_not_additionally_fixed\": true\n  },\n  \"passed\": 21,\n  \"failed\": [],\n  \"general_symbol\": \"-a*c*sqrt(s)*(1 - s)**(3/2)/(a**2*s - a**2 - c**2*s + c**2)\",\n  \"full_coordinate_slope_operator_a1_c2\": \"2*sqrt(1 - s)*(s**2*Derivative(f(s), (s, 2)) - s*Derivative(f(s), (s, 2)) - 4*f(s))/(3*sqrt(s)*(s - 1))\",\n  \"no_inverse_coordinate_slope_operator_a1_c2\": \"-2*sqrt(s)*(s - 1)*Derivative(f(s), (s, 2))/(3*sqrt(1 - s))\",\n  \"full_third_jet\": \"1/3\",\n  \"omissions\": [\n    \"no global Q computation\",\n    \"no nonlinear constraint solve\",\n    \"no Cauchy solve\",\n    \"no numerical orbit integration\",\n    \"finite controls do not certify methods or universal quantifiers\"\n  ]\n}\n",
