    check("pure_reciprocal_basis_normalizes_phi", b == 1)
    check("selected_basis_pair_unique", (a, b) == (Fraction(0), Fraction(1)))
    for dk, dp in ((Fraction(2), Fraction(3)), (Fraction(-5), Fraction(7))):
