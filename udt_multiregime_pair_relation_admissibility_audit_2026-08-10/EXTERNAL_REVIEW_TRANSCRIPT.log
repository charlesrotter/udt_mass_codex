def mirrored_git_show(cmd, cwd=None, text=False, **kwargs):
    if cmd[:2] == ['git', 'show']:
        rel = cmd[2].split(':', 1)[1]
        raw = (ROOT / 'sources' / rel).read_bytes()
        return raw.decode('utf-8') if text else raw
    raise RuntimeError(str(cmd))

def run_mod(mod, patch_write_tsv=False):
