n      \"a\": \"2\",\n      \"c\": \"1\",\n      \"Lambda\": 0,\n      \"K\": [\n        [\n          \"1\",\n          \"0\",\n          \"0\"\n        ],\n        [\n          \"0\",\n          \"2\",\n          \"0\"\n        ],\n        [\n          \"0\",\n          \"0\",\n          \"-47/48\"\n        ]\n      ]\n    },\n    {\n      \"a\": \"2\",\n      \"c\": \"1\",\n      \"Lambda\": 3,\n      \"K\": [\n        [\n          \"1\",\n          \"0\",\n          \"0\"\n        ],\n        [\n          \"0\",\n          \"1\",\n          \"0\"\n        ],\n        [\n          \"0\",\n          \"0\",\n          \"17/32\"\n        ]\n      ]\n    },\n    {\n      \"a\": \"2\",\n      \"c\": \"1\",\n      \"Lambda\": 3,\n      \"K\": [\n        [\n          \"-2/3\",\n          \"2/3\",\n          \"0\"\n        ],\n        [\n          \"2/3\",\n          \"-4/3\",\n          \"0\"\n        ],\n        [\n          \"0\",\n          \"0\",\n          \"-233/288\"\n        ]\n      ]\n    },\n    {\n      \"a\": \"2\",\n      \"c\": \"1\",\n      \"Lambda\": 3,\n      \"K\": [\n        [\n          \"1\",\n          \"0\",\n          \"0\"\n        ],\n        [\n          \"0\",\n          \"2\",\n          \"0\"\n        ],\n        [\n          \"0\",\n          \"0\",\n          \"1/48\"\n        ]\n      ]\n    }\n  ],\n  \"hostiles_caught\": [\n    \"omit raising term\",\n    \"symmetric projector for mixed K\",\n    \"omit momentum connection\",\n    \"allow vertical shear off constraint\",\n    \"erase horizontal shear Hamiltonian\",\n    \"wrong norm sign Hamiltonian\",\n    \"wrong negative K sign\",\n    \"drop derivative-index connection\"\n  ],\n  \"symbolic_momentum\": [\n    \"-p*t + q*t\",\n    \"p*r - q*r\",\n    \"0\"\n  ],\n  \"symbolic_S\": [\n    [\n      \"2*p**2*u - 2*p**2*w - q**2*v + q**2*w\",\n      \"4*p**2*z - q**2*z\",\n      \"2*p*q*r + q**2*r\"\n    ],\n    [\n      \"4*p**2*z - q**2*z\",\n      \"-2*p**2*u + 2*p**2*w + q**2*u - q**2*v\",\n      \"2*p*q*t + q**2*t\"\n    ],\n    [\n      \"2*p*q*r + q**2*r\",\n      \"2*p*q*t + q**2*t\",\n      \"-q**2*u + 2*q**2*v - q**2*w\"\n    ]\n  ],\n  \"symbolic_Pdot\": [\n    [\n      \"0\",\n      \"0\",\n      \"2*r*(-p - q)/(p - q)\"\n    ],\n    [\n      \"0\",\n      \"0\",\n      \"2*t*(-p - q)/(p - q)\"\n    ],\n    [\n      \"-4*p*r/(p - q)\",\n      \"-4*p*t/(p - q)\",\n      \"0\"\n    ]\n  ],\n  \"limitations\": [\n    \"finite checks support but do not prove analytic quantifiers\",\n    \"formal mixed-jet control not a lawful-data witness\",\n    \"no time persistence or inhomogeneous constraint census\"\n  ]\n}\n"
